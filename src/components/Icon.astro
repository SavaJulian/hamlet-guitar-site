---
interface Props {
  name: 'arrow' | 'play' | 'phone' | 'pin' | 'plus' | 'close' | 'star' | 'message';
  size?: number;
}
const { name, size = 20 } = Astro.props;
const paths = {
  arrow: 'M4 12h16M13 5l7 7-7 7',
  play: 'M9 5l11 7-11 7V5Z',
  phone: 'M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 2a14 14 0 0 1-6-6l2-2-2-5Z',
  pin: 'M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  plus: 'M12 5v14M5 12h14',
  close: 'M5 5l14 14M19 5 5 19',
  star: 'm12 2 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1 3-6Z',
  message: 'M21 11.5a8.5 8.5 0 0 1-8.5 8.5H3l2-5a8.5 8.5 0 1 1 16-3.5Z',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={name === 'play' || name === 'star' ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={paths[name]}></path></svg
>
