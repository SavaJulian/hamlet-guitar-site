---
import Icon from './Icon.astro';
import { withBase } from '../lib/site';

interface Props {
  action?: string;
  hiddenFields?: Record<string, string>;
}

const { action, hiddenFields = {} } = Astro.props;
const ready = Boolean(action);
---

<form
  id="kennismakingsformulier"
  class="inquiry-form"
  action={action}
  method="post"
  data-inquiry
  data-ready={String(ready)}
  aria-label="Gratis kennismakingsles aanvragen"
  aria-describedby="lesson-form-note"
>
  {Object.entries(hiddenFields).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
  <div class="form-fields">
    <div class="form-field form-field-wide">
      <label for="lesson-name">Je naam <span>(verplicht)</span></label>
      <input
        id="lesson-name"
        name="naam"
        type="text"
        autocomplete="name"
        maxlength="120"
        required
        aria-describedby="lesson-name-error"
      />
      <p class="field-error" id="lesson-name-error" hidden></p>
    </div>
    <div class="form-field">
      <label for="lesson-email">E-mailadres <span>(verplicht)</span></label>
      <input
        id="lesson-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        required
        aria-describedby="lesson-email-error"
      />
      <p class="field-error" id="lesson-email-error" hidden></p>
    </div>
    <div class="form-field">
      <label for="lesson-phone">Telefoonnummer <span>(optioneel)</span></label>
      <input id="lesson-phone" name="telefoon" type="tel" autocomplete="tel" maxlength="40" />
    </div>
    <div class="form-field form-field-wide">
      <label for="lesson-interest">Waar sta je nu? <span>(optioneel)</span></label>
      <select id="lesson-interest" name="interesse">
        <option value="">Kies wat bij je past</option>
        <option>Ik begin net</option>
        <option>Ik speel al gitaar</option>
        <option>Ik wil flamenco leren</option>
      </select>
    </div>
    <div class="form-field form-field-wide">
      <label for="lesson-message">Wat wil je graag leren? <span>(optioneel)</span></label>
      <textarea id="lesson-message" name="bericht" rows="3" maxlength="1200"></textarea>
    </div>
  </div>
  <p class="form-note" id="lesson-form-note">
    Met je aanvraag spreek je een moment af voor je gratis kennismakingsles. Je les is nog niet geboekt.
  </p>
  <button class="btn form-submit" type="submit" disabled={!ready}>
    <span>Vraag je gratis les aan</span><Icon name="arrow" />
  </button>
  <p class="form-status" id="lesson-form-status" role="status" aria-live="polite">
    {!ready && 'Dit formulier staat klaar als voorbeeld. Verzenden is nog niet ingeschakeld.'}
  </p>
  <p class="form-privacy">
    Hamlet gebruikt je gegevens om je vraag over gitaarles te beantwoorden. <a href={withBase('/privacy/')}
      >Lees het privacybeleid.</a
    >
  </p>
  <a class="form-phone" href="tel:+32483502220">Liever bellen? <span>0483 50 22 20</span></a>
  <noscript
    ><p class="form-note">Je kunt Hamlet ook rechtstreeks bellen om een kennismakingsles af te spreken.</p></noscript
  >
</form>
