---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/site';
---

<SimpleLayout title="Pagina niet gevonden — Hamlet">
  <div class="stack">
    <p class="eyebrow">Hamlet · 404</p>
    <h1>Even een andere snaar.</h1>
    <p class="lede">
      Deze pagina bestaat niet. Je vindt Hamlet’s live muziek, de gitaarlessen en zijn contactgegevens op de
      startpagina.
    </p>
    <a class="btn" href={withBase('/')}>Terug naar de startpagina <Icon name="arrow" /></a>
  </div>
</SimpleLayout>
