---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Rosette from '../components/Rosette.astro';
import Strings from '../components/Strings.astro';
import LessonForm from '../components/LessonForm.astro';
import VideoGallery, { type Video } from '../components/VideoGallery.astro';
import { absoluteUrl, withBase } from '../lib/site';
import { lessonFormEndpoint } from '../lib/lessonForm';

const phone = '+32483502220';
const maps = 'https://www.google.com/maps?cid=4943289985205439662';
const formAction = lessonFormEndpoint(import.meta.env.PUBLIC_LESSON_FORM_ENDPOINT);
const next = absoluteUrl('/bedankt/', Astro.site);
const formFields = {
  _subject: 'Hamlet — aanvraag gratis kennismakingsles',
  _template: 'table',
  ...(next ? { _next: next } : {}),
};
const canonical = absoluteUrl('/gitaarles/', Astro.site);
const reviews = [
  {
    name: 'Artiom',
    role: 'Leerling',
    text: '“Sinds de lessen bij Hamlet luister ik anders naar flamenco. Ik hoor nu veel beter wat de gitaar met het ritme doet. En als je zo’n stukje dan zelf eindelijk goed speelt, geeft dat echt voldoening.”',
  },
  {
    name: 'Julian',
    role: 'Leerling',
    text: '“Ik vond de flamencolessen bij Hamlet echt tof. Hij legt alles rustig uit en helpt je als je even vastzit. Merci Hamlet!”',
  },
  {
    name: 'Siel',
    role: 'Leerling via Apprentus · 2022',
    text: '“Fantastische maar vooral gepassioneerde leerkracht!”',
  },
];
const videos: Video[] = [
  {
    kind: 'file',
    href: withBase('/media/les-julian-1.mp4'),
    poster: 'media/video-les-julian-1.webp',
    ratio: '1.7792',
    title: 'Les met Julian en Artiom, deel 1',
    meta: '22 seconden',
  },
  {
    kind: 'file',
    href: withBase('/media/les-julian-2.mp4'),
    poster: 'media/video-les-julian-2.webp',
    ratio: '1.7792',
    title: 'Les met Julian en Artiom, deel 2',
    meta: '38 seconden',
  },
  {
    kind: 'file',
    href: withBase('/media/les-artiom-1.mp4'),
    poster: 'media/video-les-artiom-1.webp',
    ratio: '1.7741',
    title: 'Les met Artiom, deel 1',
    meta: '20 seconden',
  },
  {
    kind: 'file',
    href: withBase('/media/les-artiom-2.mp4'),
    poster: 'media/video-les-artiom-2.webp',
    ratio: '1.7741',
    title: 'Les met Artiom, deel 2',
    meta: '2 minuten 45',
  },
  {
    kind: 'file',
    href: withBase('/media/les-pablo.mp4'),
    poster: 'media/video-les-pablo.webp',
    ratio: '0.5577',
    title: 'Les met Pablo',
    meta: '53 seconden',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Gitaarlessen Hamlet',
  description:
    'Persoonlijke gitaarlessen in Merksem, Antwerpen. Spaanse gitaar en flamenco voor beginners en gevorderden.',
  telephone: phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Bredabaan 479',
    postalCode: '2170',
    addressLocality: 'Antwerpen',
    addressCountry: 'BE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 51.2448788, longitude: 4.4467246 },
  hasMap: maps,
  areaServed: ['Merksem', 'Antwerpen'],
  ...(canonical ? { url: canonical, image: absoluteUrl('/media/hamlet-portret.webp', Astro.site) } : {}),
};
---

<SiteLayout
  title="Gitaarles in Merksem, Antwerpen | Hamlet"
  ogTitle="Hamlet — leer gitaar spelen. Op jouw tempo."
  description="Leer gitaar spelen bij Hamlet in Merksem, Antwerpen. Je eerste kennismakingsles is gratis. Van je eerste akkoord tot Spaanse gitaar en flamenco."
  path="/gitaarles/"
  current="les"
  action={{ href: '#contact', label: 'Plan je gratis les' }}
  schema={schema}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" style="--i:0">Gitaarles · Merksem, Antwerpen</p>
        <h1 id="hero-heading" style="--i:1">Leer gitaar spelen. Op jouw tempo.</h1>
        <p class="lede" style="--i:2">
          Spaanse gitaar en flamenco, voor beginners en gevorderden. Je eerste kennismakingsles is gratis.
        </p>
        <div class="hero-actions" style="--i:3">
          <a class="btn" href="#contact" data-primary-action data-strum>Plan je gratis les <Icon name="arrow" /></a>
          <a class="text-link" href="#videos">Kijk mee in een les</a>
        </div>
      </div>
      <div class="hero-art">
        <Rosette alt="Hamlet speelt flamencogitaar" eager />
      </div>
      <div class="hero-strings"><Strings strum="load" /></div>
    </div>
    <div class="shell hero-facts">
      <span><b>30 jaar</b> leservaring</span>
      <span><b>60 minuten</b> per les</span>
      <span><b>Eerste les</b> gratis</span>
    </div>
  </section>

  <section class="section" id="videos" aria-labelledby="videos-heading">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2 id="videos-heading">Kijk mee in een les</h2>
        <p>Drie lessen, van een eerste begin tot samen spelen.</p>
      </div>
      <VideoGallery videos={videos} />
    </div>
  </section>

  <section class="section" id="reviews" aria-labelledby="reviews-heading" style="padding-top:0">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2 id="reviews-heading">Wat leerlingen zeggen</h2>
      </div>
      <div class="review-grid">
        {
          reviews.map((review, index) => (
            <figure class="quote-card quote-card-mist" data-reveal style={`--i:${index}`}>
              <div>
                <span class="stars" role="img" aria-label="5 van 5 sterren">
                  {Array.from({ length: 5 }, () => (
                    <Icon name="star" size={18} />
                  ))}
                </span>
                <blockquote>{review.text}</blockquote>
              </div>
              <figcaption>
                <span class="quote-initial" aria-hidden="true">
                  {review.name[0]}
                </span>
                <span>
                  <strong>{review.name}</strong>
                  {review.role}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-mist" id="hamlet" aria-labelledby="teacher-heading">
    <div class="shell split">
      <div class="stack" data-reveal>
        <p class="eyebrow">Je leraar, Hamlet</p>
        <h2 id="teacher-heading">Liefde voor gitaar. Aandacht voor jou.</h2>
        <p>
          Je hoort het wanneer Hamlet speelt: de gitaar is zijn taal. Hij speelt al 43 jaar gitaar, geeft 30 jaar les en
          is gespecialiseerd in Spaanse gitaar en flamenco, van traditionele klanken tot een moderne benadering.
        </p>
        <p>
          In de les draait het om jouw spel. Je krijgt persoonlijke begeleiding en oefeningen om thuis mee verder te
          gaan. Of je nu voor het eerst een gitaar vastneemt of al jaren speelt.
        </p>
        <a class="text-link" href="#contact">Maak kennis met Hamlet <Icon name="arrow" size={18} /></a>
      </div>
      <div class="pill-photo" data-reveal style="--i:1">
        <div>
          <img
            src={withBase('/media/hamlet-handen.webp')}
            width="1055"
            height="257"
            alt="De handen van Hamlet op de gitaar"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="practice-heading">
    <div class="shell">
      <div class="stack" data-reveal>
        <p class="eyebrow">Ruimte om te leren</p>
        <h2 id="practice-heading">Een uur voor jezelf. En je gitaar.</h2>
        <p>
          Proberen, vragen stellen en opnieuw spelen. Met oefeningen voor thuis neem je de muziek mee, ook nadat de les
          voorbij is.
        </p>
        <div class="facts">
          <div><strong>60 min.</strong><span>per reguliere les</span></div>
          <div><strong>Jouw tempo</strong><span>persoonlijke begeleiding</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-mist" id="contact" aria-labelledby="contact-heading" data-form-section>
    <div class="shell split split-top">
      <div class="stack" data-reveal>
        <p class="eyebrow">Zet de eerste stap</p>
        <h2 id="contact-heading">Jouw eerste les. Helemaal gratis.</h2>
        <p class="lede">
          Maak kennis met Hamlet en ontdek hoe gitaarles bij hem voelt. Vertel iets over jezelf, dan spreken jullie
          samen een moment af.
        </p>
        <div class="location">
          <span class="location-icon"><Icon name="pin" size={22} /></span>
          <div>
            <h3>Tot in Merksem.</h3>
            <address>Gitaarlessen Hamlet<br />Bredabaan 479<br />2170 Merksem, Antwerpen</address>
            <a class="text-link" href={maps} target="_blank" rel="noopener noreferrer"
              >Plan je route <Icon name="arrow" size={18} /></a
            >
            <small>Lessen op afspraak</small>
          </div>
        </div>
      </div>
      <div class="form-card" data-reveal style="--i:1">
        <h3 class="form-heading">Vertel, wat wil jij spelen?</h3>
        <p class="form-intro">Vul je gegevens in voor je gratis kennismakingsles.</p>
        <LessonForm action={formAction} hiddenFields={formFields} />
      </div>
    </div>
  </section>
</SiteLayout>
