---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Rosette from '../components/Rosette.astro';
import Strings from '../components/Strings.astro';
import BookingForm from '../components/BookingForm.astro';
import { absoluteUrl, withBase } from '../lib/site';
import { lessonFormEndpoint } from '../lib/lessonForm';

const formAction = lessonFormEndpoint(import.meta.env.PUBLIC_LESSON_FORM_ENDPOINT);
const next = absoluteUrl('/bedankt-boeking/', Astro.site);
const formFields = {
  _subject: 'Hamlet — aanvraag avond live muziek',
  _template: 'table',
  ...(next ? { _next: next } : {}),
};
const videos = [
  {
    kind: 'youtube',
    youtube: 'MEcC6SS83Bc',
    href: 'https://youtu.be/MEcC6SS83Bc',
    poster: 'media/video-rumba.webp',
    ratio: '1.7778',
    title: 'Rumba van Philip John Lee',
    meta: 'Speelt af via YouTube',
  },
  {
    kind: 'file',
    href: withBase('/media/hamlet-podium.mp4'),
    poster: 'media/video-podium.webp',
    ratio: '0.5625',
    title: 'Live op het podium',
    meta: '1 minuut',
  },
  {
    kind: 'file',
    href: withBase('/media/hamlet-dichtbij.mp4'),
    poster: 'media/video-dichtbij.webp',
    ratio: '1.7251',
    title: 'Van dichtbij',
    meta: '1 minuut',
  },
];
---

<SiteLayout
  title="Live flamencogitaar voor cafés, restaurants en events | Hamlet"
  ogTitle="Hamlet — live flamencogitaar in cafés en restaurants"
  description="Hamlet speelt live Spaanse gitaar en flamenco in cafés en restaurants, op feesten en events in Antwerpen. Bekijk hem live en boek een avond."
  path="/"
  current="live"
  action={{ href: '#boeken', label: 'Boek een avond' }}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" style="--i:0">Live flamencogitaar · Antwerpen</p>
        <h1 id="hero-heading" style="--i:1">Live flamencogitaar in cafés en restaurants.</h1>
        <p class="lede" style="--i:2">
          Hamlet speelt Spaanse gitaar en flamenco op café- en restaurantavonden, feesten en events. Haal hem naar jouw
          zaak.
        </p>
        <div class="hero-actions" style="--i:3">
          <a class="btn" href="#boeken" data-primary-action data-strum>Boek een avond <Icon name="arrow" /></a>
          <a class="text-link" href="#videos">Bekijk hem live</a>
        </div>
      </div>
      <div class="hero-art">
        <Rosette alt="Hamlet speelt flamencogitaar" eager />
      </div>
      <div class="hero-strings"><Strings strum="load" /></div>
    </div>
    <div class="shell hero-facts">
      <span><b>24 jaar</b> ervaring</span>
      <span><b>Cafés</b> en restaurants</span>
      <span><b>Feesten</b> en events</span>
    </div>
  </section>

  <section class="section" id="videos" aria-labelledby="videos-heading">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2 id="videos-heading">Bekijk Hamlet live</h2>
        <p>Drie opnames, zodat je hoort wat je boekt.</p>
      </div>
      <div class="video-grid">
        {
          videos.map((video, index) => (
            <div class="video-tile" data-reveal style={`--i:${index}`}>
              <a
                class="video-thumb"
                href={video.href}
                data-video={video.kind}
                data-youtube={video.youtube}
                data-ratio={video.ratio}
                data-title={video.title}
                aria-label={`Speel af: ${video.title}`}
              >
                <img src={withBase(video.poster)} width="960" height="540" alt="" loading="lazy" decoding="async" />
                <span class="play">
                  <Icon name="play" size={26} />
                </span>
              </a>
              <div>
                <p class="video-title">{video.title}</p>
                <p class="video-meta">{video.meta}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <dialog class="video-dialog" id="video-dialog" aria-label="Video">
      <button class="dialog-close" type="button" aria-label="Video sluiten"><Icon name="close" size={22} /></button>
      <div class="dialog-stage"></div>
    </dialog>
  </section>

  <section class="section section-mist" id="boeken" aria-labelledby="booking-heading" data-form-section>
    <div class="shell split">
      <div class="stack" data-reveal>
        <p class="eyebrow">Voor cafés, restaurants, feesten en events</p>
        <h2 id="booking-heading">Boek een avond</h2>
        <p class="lede">
          Een avond live flamencogitaar voor je gasten. Vertel waar en wanneer, dan spreekt Hamlet de rest met je af.
        </p>
        <ul class="chips" aria-label="Hamlet speelt op">
          <li>Café</li>
          <li>Restaurant</li>
          <li>Feest</li>
          <li>Event</li>
        </ul>
        <div class="pill-photo">
          <div>
            <img
              src={withBase('/media/hamlet-handen.webp')}
              width="1055"
              height="257"
              alt="De handen van Hamlet op de gitaar"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="form-card" data-reveal style="--i:1">
        <BookingForm action={formAction} hiddenFields={formFields} />
      </div>
    </div>
  </section>

  <section class="band on-dark" aria-labelledby="lessons-band-heading">
    <div class="shell">
      <div>
        <h2 id="lessons-band-heading">Zelf gitaar leren spelen?</h2>
        <p>Hamlet geeft ook les, voor beginners en gevorderden. Je eerste les is gratis.</p>
      </div>
      <a class="btn btn-light" href={withBase('/gitaarles/')}>Naar de gitaarlessen <Icon name="arrow" /></a>
    </div>
  </section>
</SiteLayout>
