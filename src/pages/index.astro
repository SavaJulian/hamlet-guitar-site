---
import '@fontsource-variable/bodoni-moda';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/hamlet.css';
import Brand from '../components/Brand.astro';
import { withBase } from '../lib/site';
import Icon from '../components/Icon.astro';
import LessonForm from '../components/LessonForm.astro';
import { lessonFormEndpoint } from '../lib/lessonForm';
const base = withBase('/');
const asset = (path: string) => `${base}${path}`;
const phone = '+32483502220';
const maps = 'https://www.google.com/maps?cid=4943289985205439662';
const lessonFormAction = lessonFormEndpoint(import.meta.env.PUBLIC_LESSON_FORM_ENDPOINT);
const lessonFormFields = {
  _subject: 'Hamlet — aanvraag gratis kennismakingsles',
  _template: 'table',
  ...(Astro.site ? { _next: new URL(asset('bedankt/'), Astro.site).href } : {}),
};
const canonical = Astro.site ? new URL(base, Astro.site).href : undefined;
const faqs = [
  [
    'Is de eerste kennismakingsles echt gratis?',
    'Ja, je eerste kennismakingsles bij Hamlet is gratis. Vul het formulier in om een moment af te spreken. Zo kun je kennismaken en ervaren hoe de gitaarles bij hem voelt.',
  ],
  [
    'Kan ik beginnen zonder ervaring?',
    'Zeker. Hamlet geeft les aan beginners én gevorderden. Je begint bij wat je al kunt, ook als dat nog helemaal niets is. Je hoeft dus niet eerst zelf akkoorden te leren.',
  ],
  [
    'Moet ik al een gitaar hebben?',
    'Een eigen gitaar is handig om thuis te oefenen. Heb je er nog geen? Bespreek dat bij je eerste contact met Hamlet. Hij kan met je meedenken over een instrument dat past bij wat je wilt spelen.',
  ],
  [
    'Gaat het alleen over flamenco?',
    'Spaanse gitaar en flamenco zijn Hamlet’s specialiteit. Wil je vooral de basis leren, je techniek verbeteren of een andere muzikale richting verkennen? Vertel het hem, zodat jullie kunnen bespreken wat bij je past.',
  ],
  [
    'Hoe lang duurt een les?',
    'Een reguliere gitaarles duurt 60 minuten. De duur en het moment van je kennismakingsles bespreek je rechtstreeks met Hamlet.',
  ],
  [
    'Wat kost de gitaarles?',
    'Je eerste kennismakingsles is gratis. Wil je daarna verder? Vraag Hamlet naar het actuele tarief voor de vervolglessen en de mogelijkheden.',
  ],
  [
    'Waar vinden de lessen plaats?',
    'Je vindt Gitaarlessen Hamlet aan de Bredabaan 479, 2170 Merksem (Antwerpen). Neem vooraf contact op om een lesmoment af te spreken.',
  ],
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Gitaarlessen Hamlet',
  description:
    'Persoonlijke gitaarlessen in Merksem, Antwerpen. Spaanse gitaar en flamenco voor beginners en gevorderden.',
  telephone: phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Bredabaan 479',
    postalCode: '2170',
    addressLocality: 'Antwerpen',
    addressCountry: 'BE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 51.2448788, longitude: 4.4467246 },
  hasMap: maps,
  areaServed: ['Merksem', 'Antwerpen'],
  ...(canonical
    ? { url: canonical, image: new URL(asset('media/hamlet-performance.webp?v=black-background'), Astro.site).href }
    : {}),
};
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gitaarles in Merksem, Antwerpen | Hamlet</title>
    <meta
      name="description"
      content="Leer gitaar spelen bij Hamlet in Merksem, Antwerpen. Je eerste kennismakingsles is gratis. Van je eerste akkoord tot Spaanse gitaar en flamenco."
    />
    <meta name="theme-color" content="#f7f5ef" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={asset('brand/hamlet-monogram.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content="Hamlet — leer gitaar spelen. Op jouw tempo." />
    <meta
      property="og:description"
      content="Persoonlijke gitaarlessen in Merksem. Je eerste kennismakingsles is gratis. Van je eerste akkoord tot de wereld van flamenco."
    />
    <meta
      property="og:image"
      content={Astro.site
        ? new URL(asset('media/hamlet-performance.webp?v=black-background'), Astro.site).href
        : asset('media/hamlet-performance.webp?v=black-background')}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Ga naar de inhoud</a>
    <header class="site-header">
      <div class="header-inner">
        <Brand />
        <nav class="desktop-nav" aria-label="Hoofdnavigatie">
          <a href="#lessen">De lessen</a><a href="#hamlet">Over Hamlet</a><a href="#vragen">Veelgestelde vragen</a>
        </nav>
        <a class="header-cta" href="#contact">Plan je gratis les <Icon name="arrow" size={18} /></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu openen"
          ><span></span><span></span></button
        >
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobiele navigatie" hidden>
        <a href="#lessen">De lessen</a><a href="#hamlet">Over Hamlet</a><a href="#vragen">Veelgestelde vragen</a><a
          href="#contact">Contact & locatie</a
        >
      </nav>
    </header>
    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-heading">
        <div class="hero-content">
          <p class="hero-intro"><span class="location-dot"></span>Gitaarles in Merksem, Antwerpen</p>
          <h1 id="hero-heading"><span>Leer gitaar<br /> spelen.</span><em>Op jouw tempo.</em></h1>
          <p class="hero-description">
            Van je eerste akkoord tot Spaanse gitaar en flamenco. Persoonlijke lessen met Hamlet, precies waar jij nu
            staat.
          </p>
          <div class="hero-actions">
            <a class="button button-gold" href="#contact">Plan je gratis les <Icon name="arrow" /></a>
            <a class="hero-secondary" href="#lessen">Ontdek de lessen</a>
          </div>
          <p class="hero-offer"><Icon name="check" size={16} /> Je eerste kennismakingsles is gratis.</p>
          <a class="hero-review" href={maps} target="_blank" rel="noopener noreferrer">
            <span class="review-stars" aria-hidden="true"
              >{Array.from({ length: 5 }, () => <Icon name="star" size={14} />)}</span
            >
            <span><strong>5,0</strong> op Google <span class="review-count">· 3 reviews</span></span>
          </a>
        </div>
        <div class="hero-media">
          <video
            id="hero-video"
            class="hero-image hero-video"
            loop
            playsinline
            preload="none"
            poster={asset('media/hamlet-performance.webp?v=black-background')}
            data-src={asset('media/hamlet-hero.mp4?v=black-background')}
            width="1280"
            height="720"
            aria-label="Hamlet speelt flamencogitaar op de achtergrond"></video>
          <button
            class="hero-playback"
            id="hero-playback"
            aria-controls="hero-video"
            aria-label="Video afspelen"
            title="Klik op het beeld om af te spelen of te pauzeren"
            data-paused><span class="hero-playback-hint">Video afspelen</span></button
          >
          <div class="performance-caption">
            <strong>Hamlet, aan het spelen.</strong><span>Spaanse gitaar & flamenco</span>
          </div>
          <button
            class="hero-sound"
            id="hero-sound"
            aria-controls="hero-video"
            aria-label="Geluid inschakelen"
            title="Geluid inschakelen"
          >
            <span data-sound-off><Icon name="sound-off" size={19} /></span><span data-sound-on hidden
              ><Icon name="sound-on" size={19} /></span
            >
          </button>
          <span class="hero-video-status" role="status" hidden
            >De video kon niet laden. <a href={base}>Opnieuw proberen</a>.</span
          >
        </div>
      </section>
      <div class="lesson-strip section-shell">
        <span><Icon name="pin" size={18} /> Merksem, Antwerpen</span>
        <span><span class="strip-dot"></span>24 jaar ervaring</span>
        <span><span class="strip-dot"></span>Beginners & gevorderden</span>
        <span><span class="strip-dot"></span>Spaanse gitaar & flamenco</span>
      </div>

      <section class="intro-section section-shell" id="lessen" aria-labelledby="lessons-heading">
        <div class="intro-heading">
          <span class="section-label">De lessen</span>
          <h2 id="lessons-heading">Begin waar<br /> jij bent.</h2>
          <p>
            Een gitaar in de hoek? Of al een paar akkoorden in de vingers? Je hoeft alleen zin te hebben om verder te
            gaan.
          </p>
          <p class="intro-footnote">Jouw muziek. Jouw vertrekpunt.</p>
        </div>
        <div class="lesson-options">
          <a class="lesson-option" href="#contact" data-interest="Ik begin net">
            <div>
              <span class="lesson-level">Voor beginners</span><h3>Je eerste akkoorden.</h3><p>
                Een fijne houding, een helder geluid en stap voor stap de basis onder je vingers.
              </p>
            </div>
            <span class="option-link"><span>Ik wil beginnen</span><Icon name="arrow" size={24} /></span>
          </a>
          <a class="lesson-option" href="#contact" data-interest="Ik speel al gitaar">
            <div>
              <span class="lesson-level">Voor wie verder wil</span><h3>Meer gevoel. Meer vrijheid.</h3><p>
                Werk aan je techniek, ritme en expressie. Geef wat je al speelt een nieuwe dimensie.
              </p>
            </div>
            <span class="option-link"><span>Ik wil verder groeien</span><Icon name="arrow" size={24} /></span>
          </a>
          <a class="lesson-option flamenco-option" href="#contact" data-interest="Ik wil flamenco leren">
            <div>
              <span class="lesson-level">Hamlet’s specialiteit</span><h3>De ziel van flamenco.</h3><p>
                Ontdek Spaanse gitaar: het ritme, de aanslag en de bijzondere kracht van flamenco.
              </p>
            </div>
            <span class="option-link"><span>Ik wil dit leren</span><Icon name="arrow" size={24} /></span>
          </a>
        </div>
      </section>

      <section class="teacher-section section-shell" id="hamlet" aria-labelledby="teacher-heading">
        <div class="teacher-photo">
          <img
            src={asset('media/lesson-craft.webp')}
            width="1122"
            height="1402"
            alt="Sfeerbeeld: Spaanse gitaar, oefenschrift en potlood als uitnodiging om muziek te leren"
            loading="lazy"
          />
          <span class="photo-caption">Techniek. Ritme. Expressie.</span>
        </div>
        <div class="teacher-copy">
          <span class="section-label">Je leraar, Hamlet</span>
          <h2 id="teacher-heading">Liefde voor gitaar.<br />Aandacht voor jou.</h2>
          <p>
            Je hoort het wanneer Hamlet speelt: de gitaar is zijn taal. Hij heeft 24 jaar ervaring en is gespecialiseerd
            in Spaanse gitaar en flamenco, van traditionele klanken tot een moderne benadering.
          </p>
          <p>
            In de les draait het om jouw spel. Je krijgt persoonlijke begeleiding en oefeningen om thuis mee verder te
            gaan. Of je nu voor het eerst een gitaar vastneemt of al jaren speelt.
          </p>
          <a class="text-link" href="#contact">Maak kennis met Hamlet <Icon name="arrow" /></a>
          <figure class="student-quote">
            <blockquote>“Fantastische maar vooral gepassioneerde leerkracht!”</blockquote>
            <figcaption>
              <span class="student-initial" aria-hidden="true">S</span><span
                ><strong>Siel</strong><span>Leerling via Apprentus · 2022</span></span
              >
              <a
                class="quote-source"
                href="https://www.apprentus.nl/priveles/antwerpen/muziek/flamenco/flamenco-guitar-beginners-to-professional-"
                id="review-source"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Lees de ervaring van Siel op Apprentus"><Icon name="arrow" size={18} /></a
              >
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="practice-section section-shell" aria-labelledby="practice-heading">
        <div class="practice-copy">
          <span class="section-label">Ruimte om te leren</span>
          <h2 id="practice-heading">Een uur voor jezelf.<br />En je gitaar.</h2>
          <p>
            Proberen, vragen stellen en opnieuw spelen. Met oefeningen voor thuis neem je de muziek mee, ook nadat de
            les voorbij is.
          </p>
          <div class="lesson-facts">
            <div><strong>60 min.</strong><span>per reguliere les</span></div><div>
              <strong>Jouw tempo</strong><span>persoonlijke begeleiding</span>
            </div>
          </div>
        </div>
        <div class="practice-image">
          <img
            src={asset('media/practice-corner.webp')}
            width="1536"
            height="1024"
            alt="Sfeerbeeld: een Spaanse gitaar en een rustige plek om thuis te oefenen"
            loading="lazy"
          />
        </div>
      </section>

      <section class="faq-section section-shell" id="vragen" aria-labelledby="faq-heading">
        <div class="faq-heading">
          <span class="section-label">Goed om te weten</span><h2 id="faq-heading">Nog een vraag?</h2><p>
            Van je eerste gitaar tot je eerste les. Hier vind je de antwoorden.
          </p><a class="text-link" href={`tel:${phone}`}>Stel je vraag aan Hamlet <Icon name="arrow" /></a>
        </div>
        <div class="faq-list">
          {
            faqs.map(([question, answer]) => (
              <details>
                <>
                  <summary>
                    {question}
                    <Icon name="plus" size={20} />
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="contact-inner section-shell">
          <div class="contact-main">
            <span class="section-label">Zet de eerste stap</span><h2 id="contact-heading">
              Jouw eerste les.<br /><em>Helemaal gratis.</em>
            </h2><p>
              Maak kennis met Hamlet en ontdek hoe gitaarles bij hem voelt. Vertel iets over jezelf, dan spreken jullie
              samen een moment af.
            </p>
          </div>
          <div class="contact-form-area">
            <h3 class="form-heading">Vertel, wat wil jij spelen?</h3><p class="form-intro">
              Vul je gegevens in voor je gratis kennismakingsles.
            </p><LessonForm action={lessonFormAction} hiddenFields={lessonFormFields} />
          </div>
          <div class="contact-location">
            <span class="location-icon"><Icon name="pin" size={22} /></span><div>
              <h3>Tot in Merksem.</h3><address>
                Gitaarlessen Hamlet<br />Bredabaan 479<br />2170 Merksem, Antwerpen
              </address><a class="text-link" href={maps} target="_blank" rel="noopener noreferrer"
                >Plan je route <Icon name="arrow" size={18} /></a
              ><span class="appointment-note">Lessen op afspraak</span>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <Brand /><p>Zes snaren. Eindeloos veel mogelijkheden.</p><a href="#main" class="back-top"
          >Terug naar boven <Icon name="arrow" size={17} /></a
        >
      </div><div class="footer-bottom">
        <span>© {new Date().getFullYear()} Gitaarlessen Hamlet</span><span>Gitaarles in Merksem · Antwerpen</span><a
          href={asset('privacy/')}>Privacy</a
        >
      </div>
    </footer>
    <a class="mobile-call" href="#contact" data-primary-visible
      ><Icon name="message" size={18} /> Plan je gratis les <Icon name="arrow" size={18} /></a
    >
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-nav');
      const closeMenu = () => {
        if (menu && menuButton) {
          menu.hidden = true;
          menuButton.setAttribute('aria-expanded', 'false');
          menuButton.setAttribute('aria-label', 'Menu openen');
        }
      };
      menuButton?.addEventListener('click', () => {
        if (!menu) return;
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menu.hidden = !open;
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
      const heroVideo = document.querySelector<HTMLVideoElement>('#hero-video');
      const soundButton = document.querySelector<HTMLButtonElement>('#hero-sound');
      const playbackButton = document.querySelector<HTMLButtonElement>('#hero-playback');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let userPaused = reducedMotion.matches;
      let heroInView = false;
      let playRequest = 0;
      let mediaFailed = false;

      const shouldPlay = () => !userPaused && heroInView && !document.hidden && !mediaFailed;
      const syncHeroControls = () => {
        if (!heroVideo || !soundButton || !playbackButton) return;
        const audible = !heroVideo.muted && !heroVideo.paused;
        const soundLabel = audible ? 'Geluid uitschakelen' : 'Geluid inschakelen';
        soundButton.setAttribute('aria-label', soundLabel);
        soundButton.title = soundLabel;
        soundButton.querySelector<HTMLElement>('[data-sound-off]')?.toggleAttribute('hidden', audible);
        soundButton.querySelector<HTMLElement>('[data-sound-on]')?.toggleAttribute('hidden', !audible);
        const playbackLabel = heroVideo.paused ? 'Video afspelen' : 'Video pauzeren';
        playbackButton.setAttribute('aria-label', playbackLabel);
        playbackButton.toggleAttribute('data-paused', heroVideo.paused);
        const hint = playbackButton.querySelector<HTMLElement>('.hero-playback-hint');
        if (hint) hint.textContent = playbackLabel;
      };
      const pauseHero = () => {
        playRequest += 1;
        heroVideo?.pause();
        syncHeroControls();
      };
      const playHero = async () => {
        if (!heroVideo || !shouldPlay()) return;
        const request = ++playRequest;
        if (!heroVideo.src) heroVideo.src = heroVideo.dataset.src || '';
        try {
          await heroVideo.play();
        } catch (error) {
          if (request !== playRequest || !shouldPlay()) return;
          // Browsers can deny audible autoplay. Keep the performance moving silently.
          if (error instanceof DOMException && error.name === 'NotAllowedError' && !heroVideo.muted) {
            heroVideo.muted = true;
            try {
              await heroVideo.play();
            } catch {
              // The image remains a keyboard- and touch-accessible play control.
            }
          }
        }
        if (request !== playRequest) return;
        if (!shouldPlay()) heroVideo.pause();
        syncHeroControls();
      };
      const updateHeroPlayback = () => {
        if (shouldPlay()) void playHero();
        else pauseHero();
      };
      if (heroVideo) {
        heroVideo.muted = false;
        heroVideo.addEventListener('play', syncHeroControls);
        heroVideo.addEventListener('pause', syncHeroControls);
        heroVideo.addEventListener('volumechange', syncHeroControls);
        heroVideo.addEventListener('error', () => {
          mediaFailed = true;
          pauseHero();
          const status = document.querySelector<HTMLElement>('.hero-video-status');
          if (status) status.hidden = false;
          if (soundButton) soundButton.disabled = true;
          if (playbackButton) playbackButton.disabled = true;
        });
        syncHeroControls();
        new IntersectionObserver(
          ([entry]) => {
            heroInView = entry.isIntersecting;
            updateHeroPlayback();
          },
          { threshold: 0 }
        ).observe(heroVideo);
      }
      soundButton?.addEventListener('click', () => {
        if (!heroVideo) return;
        if (!heroVideo.muted && !heroVideo.paused) heroVideo.muted = true;
        else {
          heroVideo.muted = false;
          userPaused = false;
          void playHero();
        }
        syncHeroControls();
      });
      playbackButton?.addEventListener('click', () => {
        if (!heroVideo) return;
        userPaused = !heroVideo.paused;
        updateHeroPlayback();
      });
      document.addEventListener('visibilitychange', updateHeroPlayback);
      reducedMotion.addEventListener('change', () => {
        userPaused = reducedMotion.matches;
        updateHeroPlayback();
      });
      const contactSection = document.querySelector('#contact');
      const mobileInquiry = document.querySelector('.mobile-call');
      if (contactSection && mobileInquiry) {
        new IntersectionObserver(([entry]) => {
          mobileInquiry.toggleAttribute('data-at-contact', entry.isIntersecting);
        }).observe(contactSection);
      }
      const primaryInquiry = document.querySelector('.hero-actions .button');
      if (primaryInquiry && mobileInquiry) {
        new IntersectionObserver(([entry]) => {
          mobileInquiry.toggleAttribute('data-primary-visible', entry.isIntersecting);
        }).observe(primaryInquiry);
      }
      document.querySelectorAll<HTMLElement>('[data-interest]').forEach((link) =>
        link.addEventListener('click', () => {
          const interest = link.dataset.interest || '';
          const select = document.querySelector<HTMLSelectElement>('#lesson-interest');
          if (select) select.value = interest;
        })
      );
    </script>
  </body>
</html>
